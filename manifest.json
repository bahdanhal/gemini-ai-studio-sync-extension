{
  "manifest_version": 3,
  "name": "AI Studio Local File Sync & Codebase Context",
  "version": "1.0.0",
  "description": "Sync files/diffs to local disk, and pack repository context into AI Studio.",
  "homepage_url": "https://github.com/bahdanhal/gemini-ai-studio-sync-extension",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
